rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sadece umutcanceyhan@gmail.com (e-postası doğrulanmış Google hesabı) okuyup yazabilir.
    // Diğer herkes için her şey kapalı.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'umutcanceyhan@gmail.com'
        && request.auth.token.email_verified == true;
    }
  }
}
